{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker connected to this repository in Workers Builds.
  "name": "legacy-foundry-applications",
  "compatibility_date": "2026-09-01",
  // Static Vite SPA: build first, then serve dist/ as static assets (no Worker script).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
